# ─────────────────────────────────────────────────────────────────────────────
# x-keeper 設定ファイルのテンプレート
# このファイルをコピーして .env という名前で保存し、実際の値を入力してください。
#   cp .env.example .env
# または http://localhost:8989 のセットアップ画面から入力できます。
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────────────────────

# Discord Bot のトークン (Developer Portal → Bot → Reset Token)
# DISCORD_BOT_TOKEN=MTxxxxxxxxxxxxxxxxxxxxxxxx.Gxxxxx.xxxx

# 監視する Discord チャンネルの ID (開発者モードでチャンネルを右クリック → コピー)
# DISCORD_CHANNEL_ID=1234567890123456789

# ── X (Twitter) / gallery-dl ─────────────────────────────────────────────────

# (推奨) gallery-dl に渡すブラウザ Cookie ファイルのパス (Netscape 形式)
# 鍵アカウントのツイートも取得したい場合に設定する。
# ブラウザ拡張機能 "Get cookies.txt LOCALLY" 等で x.com のクッキーを書き出し
# data/ フォルダに配置すること。
# GALLERY_DL_COOKIES_FILE=./data/x.com_cookies.txt

# Pixiv の OAuth リフレッシュトークン (Pixiv ダウンロードに必須)
# 取得方法: gallery-dl oauth:pixiv (または docker exec -it x-keeper gallery-dl oauth:pixiv)
# PIXIV_REFRESH_TOKEN=

# ── 保存先 ───────────────────────────────────────────────────────────────────

# 画像の保存先ルートディレクトリ
# Docker 運用時は docker-compose.yml の SAVE_PATH=/data が自動で適用されるため設定不要
# ローカル実行時のデフォルト: ./data
# SAVE_PATH=./data

# ── Web サーバー ──────────────────────────────────────────────────────────────

# Web セットアップ / ギャラリー画面のポート番号
# ブラウザで http://localhost:<このポート> を開く。デフォルト: 8989
# WEB_SETUP_PORT=8989

# ── ロギング ──────────────────────────────────────────────────────────────────
# ログレベル: DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# ── キュー・ギャラリー ────────────────────────────────────────────────────────

# API キューのポーリング間隔 (秒)。デフォルト: 30
# RETRY_POLL_INTERVAL=30

# ギャラリートップで先読みするサムネイル数。デフォルト: 50
# GALLERY_THUMB_COUNT=50


# API トークン。設定すると /api/* が保護される (未設定なら認証なし)。
# セットアップ画面 (http://localhost:8989/?setup=1) の「生成する」でも作れる。
# ヘッダ: X-API-Token: <token> / Authorization: Bearer <token>
# API_TOKEN=

# ── 通知 ─────────────────────────────────────────────────────────────────────

# ダウンロード完了/失敗時に JSON を POST する Webhook URL。未設定なら通知しない。
# NOTIFY_WEBHOOK_URL=
