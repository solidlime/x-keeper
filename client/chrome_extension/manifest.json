{
  "manifest_version": 3,
  "name": "x-keeper Client",
  "version": "1.4.0",
  "description": "X / Pixiv / Imgur / YouTube / TikTok / NicoNico のメディアを x-keeper サーバーに送信してダウンロードする",

  "permissions": [
    "storage",
    "webNavigation",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.pixiv.net/*",
        "https://imgur.com/*",
        "https://www.youtube.com/*",
        "https://www.tiktok.com/*",
        "https://www.nicovideo.jp/*"
      ],
      "js": ["content_scripts/content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
